# 复制为 .env 后填入自己的密钥即可（.env 已被 .gitignore 排除，不会进版本库）
# 全部配置项说明见 README「切换模型（只改 .env）」

# ---- API 配置 ----------------------------------------------
DASHSCOPE_API_KEY = sk-xxxxxxxxxxxxxxxxxxxxxxxx
# 一般留空；只有专属网关才填原生 API 根地址
DASHSCOPE_BASE_URL =

# ---- 模型配置 ----------------------------------------------
# 填你账号下「百炼 → 模型列表」里可用的型号，代码不写死任何模型名
# CHAT_MODEL_MODE 必须与模型匹配，否则调用会返回 400 "url error, please check url!"：
#   text       → 文本生成端点（qwen-plus / qwen-max / qwen-turbo …）
#   multimodal → 多模态端点（gui-plus / qwen3.7-plus …）
CHAT_MODEL_NAME = qwen-plus
CHAT_MODEL_MODE = text
EMBEDDING_MODEL_NAME = text-embedding-v4
TEMPERATURE = 0.1
TOP_P = 0.8
MAX_RETRIES = 3

# ---- 功能开关 ----------------------------------------------
ENABLE_QUERY_REWRITE = 1
DEBUG_PROMPT = 0
